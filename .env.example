# 뉴스 소스: naver (NAVER API HUB) 또는 google (구글 뉴스 RSS)
NEWS_SOURCE=naver

# ===== NAVER API HUB (검색 API) =====  ※ NEWS_SOURCE=naver 일 때만 필요
# Ncloud 콘솔 > NAVER API HUB > 애플리케이션 > API관리 > 인증정보
NCP_API_KEY_ID=여기에_Client_ID
NCP_API_KEY=여기에_Client_Secret

# ===== 디스코드 웹훅 =====
DISCORD_WEBHOOK_URL=여기에_웹훅_URL

# ===== 감시 설정 =====
# 감시 대상은 keywords.json 에서 관리하는 걸 권장합니다.
KEYWORDS=

# 검사 주기(초). 300 = 5분
CHECK_INTERVAL=300

# 검색어당 한 번에 확인할 최대 기사 수 (네이버 최대 100)
DISPLAY=20

# 하루 API 호출 상한 (무료 한도 25,000 아래 안전망). 0이면 무제한
DAILY_CALL_CAP=10000
